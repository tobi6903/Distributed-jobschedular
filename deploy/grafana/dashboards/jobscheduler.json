        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (queue, status) (jobscheduler_queue_depth{status=~\"pending|retrying\"}))",
          "legendFormat": "",
          "refId": "A"
